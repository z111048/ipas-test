        {
            "block_label": "paragraph_title",
            "block_content": "3.1 No code / Low code 概念",
            "block_bbox": [
                340,
                813,
                1232,
                888
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
