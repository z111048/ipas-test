        {
            "block_label": "paragraph_title",
            "block_content": "A. 機器學習的特徵",
            "block_bbox": [
                296,
                1601,
                745,
                1664
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    296.0,
