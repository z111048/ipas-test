        {
            "block_label": "paragraph_title",
            "block_content": "3.4 鑑別式 AI 與生成式 AI 概念",
            "block_bbox": [
                320,
                615,
                1367,
                691
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
                [
                    320.0,
