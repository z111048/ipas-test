                ],
                [
                    291.0,
                    2475.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "生成式 AI 的主要目標是根據龐大的數據集訓練模型，生成多樣且創新的內容，能夠根據輸入條件或隨機變數，產生文本、圖像、音訊、影片等多種形式的內容，展現出高度靈活性與創造力。",
            "block_bbox": [
                293,
                2518,
                2081,
                2780
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    293.0,
                    2518.0
