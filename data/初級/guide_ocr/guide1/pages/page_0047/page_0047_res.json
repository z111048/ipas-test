                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "A. 損失函數",
            "block_bbox": [
                296,
                1303,
                591,
                1364
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
