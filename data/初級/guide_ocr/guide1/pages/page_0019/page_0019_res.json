            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "(2) 非監督式學習（Unsupervised Learning）",
            "block_bbox": [
                294,
                2203,
                1299,
                2265
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
