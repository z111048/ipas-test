          662.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "類別加權（Class Weighting）：在模型訓練時，根據各類別樣本數自動或手動調整損失函數中的權重，使模型在訓練時對少數類別更為敏感。",
      "block_bbox": [
        399,
        704,
        2078,
        864
      ],
      "block_id": 3,
      "block_order": 3,
      "group_id": 3,
      "block_polygon_points": [
        [
          399.0,
          704.0
        ],
        [
          2078.0,
          704.0
        ],
        [
          2078.0,
          864.0
        ],
        [
          399.0,
          864.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "• 欠抽樣與過抽樣（Under-sampling / Over-sampling）：針對資料分佈不均的情況，透過刪除過多樣本或合成少數樣本（如 SMOTE）來平衡資料集，提升模型對不同類別的辨識能力。",
      "block_bbox": [
        399,
        904,
        2076,
        1165
      ],
      "block_id": 4,
      "block_order": 4,
      "group_id": 4,
      "block_polygon_points": [
        [
          399.0,
          904.0
        ],
        [
          2076.0,
          904.0
        ],
        [
          2076.0,
          1165.0
        ],
        [
          399.0,
          1165.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "弱標註與主動學習技術（Weak Labeling / Active Learning）：在面對大規模但標註品質參差的資料時，可透過規則式預標註、自動化推理、或以模型協助進行樣本篩選與重標註，減少人工負擔並提升標註一致性。",
      "block_bbox": [
        400,
        1204,
        2080,
        1464
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
      "block_polygon_points": [
        [
          400.0,
          1204.0
        ],
        [
          2080.0,
          1204.0
        ],
        [
          2080.0,
          1464.0
        ],
        [
          400.0,
          1464.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "資料清理與品質控制流程：建立標準化的資料清洗管道，例如移除明顯異常值、偵測與合併重複樣本、針對高雜訊欄位進行欄位刪除或替代策略，確保模型訓練基礎具備穩定性與代表性。",
      "block_bbox": [
        399,
        1504,
        2077,
        1765
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
      "block_polygon_points": [
        [
          399.0,
          1504.0
        ],
        [
          2077.0,
          1504.0
        ],
        [
          2077.0,
          1765.0
        ],
        [
          399.0,
          1765.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "在模型評估層面，也應補充使用類別敏感指標（如 F1-score、Balanced Accuracy、Macro AUC 等），避免僅依賴整體準確率（Accuracy）這類易被主類別主導的指標。當應用情境與公平性高度相關（如金融核貸、醫療風險評估），更應導入公平性評估機制（如 Demographic Parity、Equalized Odds 等），協助觀測模型是否對不同子群體產生不均結果。",
      "block_bbox": [
        294,
        1805,
        2082,
        2266
      ],
      "block_id": 7,
      "block_order": 7,
      "group_id": 7,
      "block_polygon_points": [
        [
          294.0,
          1805.0
        ],
        [
          2082.0,
          1805.0
        ],
        [
          2082.0,
          2266.0
        ],
        [
          294.0,
          2266.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "綜上所述，大數據雖然帶來前所未有的樣本規模，但其品質與分佈偏態問題亦為模型表現與可信度帶來深遠影響。唯有建構系統性的資料品質管理機制與公平性驗證流程，才能在實務中建立可用、可信且合乎倫理的 AI 模型。",
      "block_bbox": [
