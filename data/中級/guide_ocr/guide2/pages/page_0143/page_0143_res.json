      ]
    },
    {
      "block_label": "text",
      "block_content": "為因應上述挑戰，常見的資料處理策略包括：",
      "block_bbox": [
        395,
        605,
        1406,
        662
      ],
      "block_id": 2,
      "block_order": 2,
      "group_id": 2,
