                ],
                [
                    295.0,
                    1467.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "（4）樣本非獨立性破壞推論基礎",
            "block_bbox": [
                296,
                1601,
                1022,
                1665
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    296.0,
