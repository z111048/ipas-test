                ],
                [
                    295.0,
                    1882.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. 大數據下敘述統計的挑戰與限制",
            "block_bbox": [
                293,
                2016,
                1093,
                2077
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
