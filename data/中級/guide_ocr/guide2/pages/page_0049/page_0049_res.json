        {
            "block_label": "text",
            "block_content": "■ 斯皮爾曼等級相關檢定是一種非參數統計方法，用於衡量兩個變數之間的等級（排名）關聯性。",
            "block_bbox": [
                515,
                1402,
                2078,
                1566
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
