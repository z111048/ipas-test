                ],
                [
                    2078.0,
                    1566.0
                ],
                [
                    515.0,
                    1566.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "與皮爾森相關檢定不同，斯皮爾曼檢定不要求變數之間的關係為線性，也不需變數分佈為常態，特別適用於順序資料、具偏態或離群值的連續變數。",
            "block_bbox": [
                523,
                1601,
                2081,
                1867
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
