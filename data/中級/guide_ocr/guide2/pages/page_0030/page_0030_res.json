            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. 統計推論概念與應用情境",
            "block_bbox": [
                296,
                1909,
                1007,
                1977
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
