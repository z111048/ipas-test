    {
      "block_label": "text",
      "block_content": "○ 斷詞（Tokenization）：將句子拆分為單詞或詞組，例如將「我愛這款手機」拆為「我」「愛」「這款」「手機」。",
      "block_bbox": [
        594,
        902,
        2076,
        1065
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
