        {
            "block_label": "text",
            "block_content": "常態分佈是最常見的連續型機率分佈之一，其數據呈現對稱的鐘形曲線。它由兩個參數決定：均值（ $ \\mu $）和標準差（ $ \\sigma $），這兩個參數決定了分佈的中心位置和擴展範圍。",
            "block_bbox": [
                473,
                1901,
                2081,
                2166
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    473.0,
                    1901.0
                ],
                [
                    2081.0,
                    1901.0
                ],
                [
                    2081.0,
                    2166.0
                ],
                [
                    473.0,
                    2166.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "常態分佈常用來描述許多自然現象中的變數行為。",
            "block_bbox": [
                475,
                2202,
                1645,
                2264
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
