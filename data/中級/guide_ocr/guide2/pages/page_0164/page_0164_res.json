        ]
      ]
    },
    {
      "block_label": "paragraph_title",
      "block_content": "（2）資料代表性與偏誤風險",
      "block_bbox": [
        296,
        1773,
        919,
        1834
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
      "block_polygon_points": [
