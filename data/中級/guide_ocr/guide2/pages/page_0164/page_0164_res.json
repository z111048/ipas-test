        [
          295.0,
          1148.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "資料是否涵蓋不同模態（如文字、圖片、聲音）、語言風格（正式、口語）、主題（科技、醫療）與使用情境（客服、創作）。",
      "block_bbox": [
        300,
        1184,
        2066,
        1346
      ],
      "block_id": 4,
      "block_order": 4,
      "group_id": 4,
      "block_polygon_points": [
        [
          300.0,
          1184.0
        ],
        [
          2066.0,
          1184.0
        ],
        [
          2066.0,
          1346.0
        ],
        [
          300.0,
          1346.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "若資料缺乏多樣性，模型可能生成單調、不自然或無法適應新場景的內容。例如，僅用科技文章訓練的語言模型可能無法生成醫療建議；僅用靜態圖片訓練的模型可能無法處理動態影像。",
      "block_bbox": [
        295,
        1383,
