        [
          295.0,
          955.0
        ]
      ]
    },
    {
      "block_label": "paragraph_title",
      "block_content": "（1）資料多樣性",
      "block_bbox": [
        295,
        1087,
        670,
        1148
      ],
      "block_id": 3,
      "block_order": 3,
      "group_id": 3,
      "block_polygon_points": [
