        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "• 顯著水準（α）是事前設定的判斷門檻，用來決定是否拒絕虛無假設。",
      "block_bbox": [
        401,
        1203,
        2010,
        1265
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
      "block_polygon_points": [
