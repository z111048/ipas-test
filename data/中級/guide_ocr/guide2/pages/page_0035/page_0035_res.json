          466.0,
          1064.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "需要特別注意的是，顯著水準  $ \\alpha $ 並不等同於檢定結果中的 p 值。",
      "block_bbox": [
        565,
        1104,
        1987,
        1164
      ],
      "block_id": 4,
      "block_order": 4,
      "group_id": 4,
      "block_polygon_points": [
