          401.0,
          1265.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "而 p 值則是在觀察到樣本資料後所計算出的機率，用來衡量資料與虛無假設的相符程度。",
      "block_bbox": [
        398,
        1303,
        2081,
        1462
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
      "block_polygon_points": [
        [
