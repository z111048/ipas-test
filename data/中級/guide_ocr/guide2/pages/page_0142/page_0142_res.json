            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "（3）資料品質與偏態問題",
            "block_bbox": [
                297,
                2403,
                870,
                2464
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
