 "order": 20, "polygon_points": [[535.0, 2428.0], [2078.0, 2428.0], [2078.0, 2589.0], [535.0, 2589.0]]}, {"cls_id": 22, "label": "text", "score": 0.9504058361053467, "coordinate": [588, 2626, 2080, 2888], "order": 21, "polygon_points": [[588.0, 2626.0], [2080.0, 2626.0], [2080.0, 2888.0], [588.0, 2888.0]]}, {"cls_id": 22, "label": "text", "score": 0.9333056211471558, "coordinate": [590, 2927, 2081, 3089], "order": 22, "polygon_points": [[590.0, 2927.0], [2081.0, 2927.0], [2081.0, 3089.0], [590.0, 3089.0]]}, {"cls_id": 16, "label": "number", "score": 0.7412404417991638, "coordinate": [2101, 3189, 2197, 3231], "order": 23, "polygon_points": [[2101.0, 3189.0], [2197.0, 3189.0], [2197.0, 3231.0], [2101.0, 3231.0]]}]}}