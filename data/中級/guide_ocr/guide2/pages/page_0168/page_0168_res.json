                [
                    294.0,
                    1278.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "大數據技術雖然能強化模型效能與預測精度，但也同時放大了資料再識別風險、資料濫用的可能性與不當自動化決策的後果。例如，即使刪除姓名，仍可能透過結合裝置資訊、地理位置或行為軌跡重新識別個人；又如，企業在未取得明確同意的情況下使用歷史數據進行模型訓練，將面臨潛在的法規責任。",
            "block_bbox": [
                294,
                1318,
                2081,
                1681
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
