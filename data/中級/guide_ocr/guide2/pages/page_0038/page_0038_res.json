                    295.0,
                    1863.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "在統計推論中，研究者利用樣本數據對母體特性進行推斷，而假設檢定是實現這一目標的核心工具。假設檢定的基本原理是評估樣本觀察結果是否與虛無假設（ $ H_{0} $）一致，進而決定是否拒絕 $ H_{0} $，間接支持對立假設（ $ H_{1} $），以推斷母體是否存在顯著的特性或差異。",
            "block_bbox": [
                290,
                1905,
                2084,
                2265
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    290.0,
                    1905.0
                ],
                [
                    2084.0,
                    1905.0
                ],
                [
                    2084.0,
                    2265.0
                ],
                [
                    290.0,
                    2265.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "不同的資料型態（如連續變數、類別變數）、研究設計（如單組、雙組、多組）以及分析目的（如均值比較、比例檢驗、相關性分析），對應著不同的統計檢定方法。選擇合適的檢定方法，不僅需要理解其統計邏輯，還需考量前提假設（如常態性、變異數齊一性）是否滿足，以確保推論結果的可靠性和有效性。",
            "block_bbox": [
                293,
                2304,
