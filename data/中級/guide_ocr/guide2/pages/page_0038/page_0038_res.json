        {
            "block_label": "paragraph_title",
            "block_content": "5. 常見統計檢定方法與應用",
            "block_bbox": [
                295,
                1796,
                1003,
                1863
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
