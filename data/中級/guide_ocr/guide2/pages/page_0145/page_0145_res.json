                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "資料來源追蹤（Data Lineage）：記錄資料從產生、傳輸、處理到應用的每一階段轉換流程與技術路徑，確保資料的可追溯性。",
            "block_bbox": [
                402,
                2105,
                2077,
                2264
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
