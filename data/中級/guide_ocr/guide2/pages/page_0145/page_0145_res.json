            ]
        },
        {
            "block_label": "text",
            "block_content": "資料編目（Data Catalog）：建立全域資料資源清單，統整資料集名稱、來源、格式、擁有者、描述與應用情境，方便團隊共享與查詢。",
            "block_bbox": [
                399,
                1905,
                2078,
                2065
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
