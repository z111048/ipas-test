                    667.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "（5）資料來源異質（Veracity & Integration）",
            "block_bbox": [
                295,
                802,
                1286,
                863
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    295.0,
                    802.0
                ],
                [
                    1286.0,
                    802.0
                ],
                [
                    1286.0,
                    863.0
                ],
                [
                    295.0,
                    863.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "在大數據環境下，資料來源不再單一，而是高度分散且多樣，來自於 IoT 裝置、WebLog、企業內部 CRM 系統、第三方 API、社群平台、用戶端裝置等多元通路。這些來源資料在格式、更新頻率、可信程度與語意標準上高度不一致，對於資料整合、治理與應用帶來極大挑戰，也使資料整合與一致性管理成為機器學習流程中不可忽視的前期核心工作。",
            "block_bbox": [
                295,
                906,
                2082,
                1366
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    295.0,
                    906.0
                ],
                [
                    2082.0,
                    906.0
                ],
                [
                    2082.0,
                    1366.0
                ],
                [
                    295.0,
                    1366.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "首先，異質資料需先經過標準化與對齊處理，才能進入建模流程。不同來源的資料可能採用不同命名規則、資料單位、編碼格式或時間戳記標準，若無統一轉換，將導致資料語意混淆與預測誤差。為此，應建構統一欄位規範與轉換邏輯（Schema Mapping），並記錄資料轉換過程中的處理歷程與依賴關係。",
            "block_bbox": [
                295,
                1404,
                2080,
                1766
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    295.0,
                    1404.0
                ],
                [
                    2080.0,
                    1404.0
                ],
                [
                    2080.0,
                    1766.0
                ],
                [
                    295.0,
                    1766.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "為提升整體資料的可監管性與信任度，應導入以下機制：",
            "block_bbox": [
                398,
                1805,
                1657,
                1865
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
