            ]
        },
        {
            "block_label": "text",
            "block_content": "作為現代深度 CNN 的奠基者，其深層架構、ReLU 激活函數、Dropout 正則化以及對 GPU 加速訓練的應用，共同開啟了圖像辨識的新時代。",
            "block_bbox": [
                530,
                1672,
                2081,
                1942
