                    464.0,
                    1544.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "AlexNet :",
            "block_bbox": [
                478,
                1578,
                754,
                1633
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
