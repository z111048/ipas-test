                    726.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "此公式表示：在事件 B 已發生的情況下，重新評估事件 A 發生機率的方式。其四個構成元素如下：",
            "block_bbox": [
                295,
                765,
                2080,
                927
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
