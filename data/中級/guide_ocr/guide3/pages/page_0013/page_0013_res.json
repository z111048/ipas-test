                    2080.0,
                    567.0
                ],
                [
                    292.0,
                    567.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ P(A|B)=\\frac{P(B|A)\\cdot P(A)}{P(B)} $$ ",
            "block_bbox": [
                400,
                598,
                923,
                726
            ],
            "block_id": 2,
            "block_order": 2,
