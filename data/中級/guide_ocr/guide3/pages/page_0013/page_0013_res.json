        {
            "block_label": "text",
            "block_content": "貝氏定理（Bayes' Theorem）正是處理這類條件推論問題的核心工具。建立在條件機率之上，是一種利用已知條件更新事件發生機率的方法：",
            "block_bbox": [
                292,
                402,
                2080,
                567
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
