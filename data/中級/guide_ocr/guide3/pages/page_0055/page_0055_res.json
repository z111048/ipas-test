        {
            "block_label": "text",
            "block_content": "支援向量迴歸（Support Vector Regression, SVR）是支援向量機（Support Vector Machine, SVM）的延伸，用於處理迴歸問題。",
            "block_bbox": [
                474,
                1102,
                2083,
                1264
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
