                [
                    474.0,
                    1264.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "◆ SVR 核心概念是在多維空間中尋找一條最能描述資料趨勢的超平面，使預測誤差落在允許範圍（ $ \\varepsilon $-tube）內，同時將超出範圍的誤差最小化。",
            "block_bbox": [
                473,
                1300,
                2078,
                1470
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    473.0,
                    1300.0
                ],
                [
                    2078.0,
                    1300.0
                ],
                [
                    2078.0,
                    1470.0
                ],
                [
                    473.0,
                    1470.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "◆ SVR 與傳統線性迴歸不同，SVR 不追求最小化所有點的平方誤差，而是盡可能忽略誤差小於  $ \\varepsilon $ 的資料點，只關注誤差超過  $ \\varepsilon $ 的點，藉此提升對離群值的抵抗力。",
            "block_bbox": [
                473,
                1500,
                2081,
                1764
            ],
            "block_id": 8,
