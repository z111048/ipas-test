            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. 最佳化問題的基本結構",
            "block_bbox": [
                295,
                1672,
                948,
                1740
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
