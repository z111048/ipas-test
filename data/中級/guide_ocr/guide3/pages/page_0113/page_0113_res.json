                    1302.0
                ],
                [
                    2080.0,
                    1466.0
                ],
                [
                    403.0,
                    1466.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "長短期記憶網路（Long Short-Term Memory, LSTM）：",
            "block_bbox": [
                477,
                1502,
                1711,
                1566
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    477.0,
                    1502.0
                ],
                [
                    1711.0,
                    1502.0
                ],
                [
                    1711.0,
                    1566.0
                ],
                [
                    477.0,
                    1566.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "■ 引入了「門控機制」（包含輸入門 Input Gate、遺忘門 Forget Gate、輸出門 Output Gate），以及一個獨立的細胞狀態（Cell State）。",
            "block_bbox": [
                529,
                1601,
                2068,
                1768
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    529.0,
                    1601.0
                ],
                [
                    2068.0,
                    1601.0
                ],
                [
                    2068.0,
                    1768.0
                ],
                [
                    529.0,
                    1768.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "這些門控單元能夠選擇性地允許資訊流入、保留在細胞狀態中、或從細胞狀態中移除，從而有效地解決了梯度消失問題，使其能更好地捕捉和記憶長期依賴關係。",
            "block_bbox": [
                520,
                1804,
                2083,
                2064
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    520.0,
                    1804.0
                ],
                [
                    2083.0,
                    1804.0
                ],
                [
                    2083.0,
                    2064.0
                ],
                [
                    520.0,
                    2064.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "門控循環單元（Gated Recurrent Unit, GRU）：",
            "block_bbox": [
                478,
                2102,
                1532,
                2165
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    478.0,
                    2102.0
                ],
                [
                    1532.0,
                    2102.0
                ],
                [
                    1532.0,
                    2165.0
                ],
                [
                    478.0,
                    2165.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "■ GRU 是 LSTM 的簡化版本，旨在提供類似的長期記憶能力，同時減少計算複雜度和參數數量。",
            "block_bbox": [
                536,
                2204,
                2078,
                2363
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    536.0,
                    2204.0
                ],
                [
                    2078.0,
                    2204.0
                ],
                [
                    2078.0,
                    2363.0
                ],
                [
                    536.0,
                    2363.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "只包含兩個門（更新門 Update Gate 和重置門 Reset Gate），結構更為緊湊，但在許多任務上仍能達到與 LSTM 相當的性能。",
            "block_bbox": [
                536,
                2404,
                2079,
                2566
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
