                    2566.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "◆ 雙向遞迴神經網路（Bidirectional RNN, Bi-RNN）：",
            "block_bbox": [
                477,
                2603,
                1648,
                2663
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
