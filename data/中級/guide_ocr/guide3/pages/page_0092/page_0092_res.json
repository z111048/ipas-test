    {
      "block_label": "text",
      "block_content": "在人工智慧的發展浪潮中，深度學習（Deep Learning）扮演了極其關鍵的角色。相較於傳統機器學習依賴手工特徵工程，深度學習透過多層神經網路結構，能自動學習數據中的高階抽象特徵，大幅提升在影像辨識、語音處理、自然語言理解及生成式AI等多領域的表現。",
      "block_bbox": [
        295,
        917,
        2079,
        1279
      ],
      "block_id": 5,
      "block_order": 4,
      "group_id": 5,
      "block_polygon_points": [
        [
          295.0,
