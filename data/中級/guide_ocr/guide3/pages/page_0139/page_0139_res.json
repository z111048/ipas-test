          2080.0,
          802.0
        ],
        [
          2080.0,
          1164.0
        ],
        [
          293.0,
          1164.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "這個過程不創造新的特徵，而是從現有特徵中進行「選擇」。透過系統化的方法保留最具價值的特徵，進而提高模型效能與解釋性。",
      "block_bbox": [
        296,
        1203,
        2079,
        1365
      ],
      "block_id": 4,
