        {
            "block_label": "text",
            "block_content": "關聯規則學習（Association Rule Learning）旨在從大型資料集中發現不同項目之間有趣的、非平凡的關係或關聯。最典型的應用是「購物籃分析」，透過分析顧客的購買行為，找出哪些商品經常被一起購買。",
            "block_bbox": [
                298,
                503,
                2084,
                767
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
