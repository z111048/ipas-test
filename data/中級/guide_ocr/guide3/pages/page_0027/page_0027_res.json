    {
      "block_label": "text",
      "block_content": "一個最佳化問題的難易度，往往取決於其目標函數的數學性質，其中凸性（Convexity）與可導性（Differentiability）是兩個最關鍵的指標：",
      "block_bbox": [
        316,
        2104,
        2079,
        2263
      ],
      "block_id": 13,
      "block_order": 13,
