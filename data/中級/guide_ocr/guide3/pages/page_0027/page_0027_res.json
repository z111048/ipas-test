      ]
    },
    {
      "block_label": "text",
      "block_content": "凸性：",
      "block_bbox": [
        401,
        2303,
        618,
        2360
      ],
      "block_id": 14,
      "block_order": 14,
      "group_id": 14,
      "block_polygon_points": [
