        {
            "block_label": "paragraph_title",
            "block_content": "1. 前言與章節導覽",
            "block_bbox": [
                299,
                810,
                782,
                876
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
