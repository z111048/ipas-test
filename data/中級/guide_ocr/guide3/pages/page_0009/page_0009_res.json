                [
                    399.0,
                    2478.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "不確定性評估：機率反映了模型對預測的信心程度，有助於風險控制與決策制定。",
            "block_bbox": [
                399,
                2517,
                2079,
                2675
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
