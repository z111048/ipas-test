                    402.0,
                    1062.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Transformer 架構是近年來在深度學習領域，特別是自然語言處理（NLP）領域引起革命性變革的一種模型。由 Google 在 2017 年的論文《Attention Is All You Need》中提出，徹底顛覆了以往 RNN/LSTM 在序列建模中的主導地位。",
            "block_bbox": [
                474,
                1103,
                2083,
                1470
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    474.0,
                    1103.0
                ],
                [
                    2083.0,
                    1103.0
                ],
                [
                    2083.0,
                    1470.0
                ],
                [
                    474.0,
                    1470.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Transformer 是一種完全基於注意力機制（Attention Mechanism）的深度學習模型架構。捨棄了傳統 RNN 的循環結構和 CNN 的卷積結構來處理序列數據。",
            "block_bbox": [
                474,
                1501,
                2080,
                1764
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    474.0,
                    1501.0
                ],
                [
                    2080.0,
                    1501.0
                ],
                [
                    2080.0,
                    1764.0
                ],
                [
                    474.0,
                    1764.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "其核心在於能夠並行化處理序列，並透過自注意力機制捕捉輸入序列中任意位置之間的長距離依賴關係。",
            "block_bbox": [
                471,
                1802,
                2079,
                1965
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
