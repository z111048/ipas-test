    },
    {
      "block_label": "text",
      "block_content": "○ 梯度的意義：",
      "block_bbox": [
        595,
        1502,
        964,
        1563
      ],
      "block_id": 7,
      "block_order": 7,
      "group_id": 7,
      "block_polygon_points": [
