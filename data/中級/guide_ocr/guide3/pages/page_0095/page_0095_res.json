          1063.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "• 引入非線性（Introduce Non-linearity）",
      "block_bbox": [
        400,
        1102,
        1291,
        1164
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
      "block_polygon_points": [
