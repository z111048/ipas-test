                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "直接識別風險",
            "block_bbox": [
                402,
                604,
                786,
                661
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    402.0,
                    604.0
                ],
                [
                    786.0,
                    604.0
                ],
                [
                    786.0,
                    661.0
                ],
                [
                    402.0,
                    661.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "指資料中含有足以「直接」辨識特定個人的欄位。",
            "block_bbox": [
                475,
                703,
                1646,
                763
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    475.0,
                    703.0
                ],
                [
                    1646.0,
                    703.0
                ],
                [
                    1646.0,
                    763.0
                ],
                [
                    475.0,
                    763.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "例如姓名、身分證號碼、電子郵件、聯絡電話、金融帳號等。",
            "block_bbox": [
                476,
                803,
                1894,
                863
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    476.0,
                    803.0
                ],
                [
                    1894.0,
                    803.0
                ],
                [
                    1894.0,
                    863.0
                ],
                [
                    476.0,
                    863.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "此類資料一旦外洩，往往立即構成隱私侵害，且多數隱私法規（如GDPR、CCPA、PDPA）均將其視為高度敏感的「個人識別資訊（Personally Identifiable Information, PII）」。因此，這類風險在企業治理中，通常被列為最高優先處理層級。",
            "block_bbox": [
                475,
                902,
                2084,
                1264
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    475.0,
                    902.0
                ],
                [
                    2084.0,
                    902.0
                ],
                [
                    2084.0,
                    1264.0
                ],
                [
                    475.0,
                    1264.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "間接識別風險（準識別資訊）",
            "block_bbox": [
                403,
                1301,
                1113,
                1364
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    403.0,
                    1301.0
                ],
                [
                    1113.0,
                    1301.0
                ],
                [
                    1113.0,
                    1364.0
                ],
                [
                    403.0,
                    1364.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "此風險源自於資料中雖無單一能辨識個體的欄位，但透過多項資訊交叉比對，仍可能「推導」出個人身份。",
            "block_bbox": [
                473,
                1404,
                2076,
                1565
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    473.0,
                    1404.0
                ],
                [
                    2076.0,
                    1404.0
                ],
                [
                    2076.0,
                    1565.0
                ],
                [
                    473.0,
                    1565.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "例如性別、出生年月、職業、地理位置、消費習慣、瀏覽紀錄等，都屬於典型的準識別資訊（Quasi-identifiers）。",
            "block_bbox": [
                476,
                1601,
                2077,
                1764
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    476.0,
                    1601.0
                ],
                [
                    2077.0,
                    1601.0
                ],
                [
                    2077.0,
                    1764.0
                ],
                [
                    476.0,
                    1764.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "實務顯示，即使資料中未包含如姓名或身分證字號等直接識別欄位，僅憑出生年月、性別及行政區域等資訊，若結合其他公開或商業資料，仍可能推測出個人身分。在台灣，尤其在人口密度較低或特定職業、族群較少的地區，間接識別風險更為顯著，顯示在大數據時代，保護準識別資訊的重要性不可忽視。",
            "block_bbox": [
                474,
                1803,
                2084,
                2266
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    474.0,
                    1803.0
                ],
                [
                    2084.0,
                    1803.0
                ],
                [
                    2084.0,
                    2266.0
                ],
                [
                    474.0,
                    2266.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "再識別風險",
            "block_bbox": [
                403,
                2303,
                736,
                2364
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    403.0,
                    2303.0
                ],
                [
                    736.0,
