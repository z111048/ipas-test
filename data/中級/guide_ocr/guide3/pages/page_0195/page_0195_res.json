                [
                    403.0,
                    2364.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "即便資料已經過去識別化處理，例如移除姓名或以代碼替代敏感欄位，仍可能因外部資料的豐富性與可取得性，而被「重新還原」出個人身分。",
            "block_bbox": [
                474,
                2404,
                2078,
                2566
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    474.0,
                    2404.0
                ],
                [
                    2078.0,
                    2404.0
                ],
                [
                    2078.0,
                    2566.0
                ],
                [
                    474.0,
                    2566.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "在實務中，若有人將不同資料來源進行交叉比對，即使是匿名化的資料集，也可能被重新識別，造成個資外洩風險。尤其在開放數據、資料共享或用於AI模型訓練的場景中，這類再識別風險更應受到高度重視。",
            "block_bbox": [
