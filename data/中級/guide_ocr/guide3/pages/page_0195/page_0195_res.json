        {
            "block_label": "text",
            "block_content": "數據隱私風險可依其對個體識別的潛在威脅程度，劃分為三種類型：",
            "block_bbox": [
                395,
                503,
                1907,
                563
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
