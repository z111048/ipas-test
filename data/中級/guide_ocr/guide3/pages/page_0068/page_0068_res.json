    {
      "block_label": "text",
      "block_content": "決策樹分類器（Decision Tree Classifier）是一種監督式學習演算法，透過一系列的「如果…那麼…」判斷規則，將資料依特徵分割成不同群組，最終在每個葉節點上給出一個類別預測。",
      "block_bbox": [
        474,
        1403,
        2079,
        1666
      ],
      "block_id": 10,
      "block_order": 10,
      "group_id": 10,
      "block_polygon_points": [
