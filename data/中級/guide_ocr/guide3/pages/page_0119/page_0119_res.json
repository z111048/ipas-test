      ]
    },
    {
      "block_label": "text",
      "block_content": "每個子層（例如注意力層或前饋網路）的輸入都會直接加到其輸出上（即 Output = Input + Sublayer (Input)）。",
      "block_bbox": [
        592,
        1304,
        2077,
        1466
      ],
      "block_id": 7,
      "block_order": 7,
      "group_id": 7,
      "block_polygon_points": [
        [
          592.0,
          1304.0
        ],
        [
          2077.0,
          1304.0
        ],
        [
          2077.0,
          1466.0
        ],
        [
          592.0,
          1466.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "這種「跳躍連接」能有效緩解訓練深層網路時的梯度消失問題，加速收斂，並允許模型構建極深的層次。",
      "block_bbox": [
        595,
        1501,
        2068,
        1666
      ],
      "block_id": 8,
      "block_order": 8,
      "group_id": 8,
      "block_polygon_points": [
