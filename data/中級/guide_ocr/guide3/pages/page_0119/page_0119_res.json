          1666.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "■ 層歸一化（Layer Normalization, LN）：",
      "block_bbox": [
        538,
        1702,
        1435,
        1764
      ],
      "block_id": 9,
      "block_order": 9,
      "group_id": 9,
      "block_polygon_points": [
        [
          538.0,
          1702.0
        ],
        [
          1435.0,
          1702.0
        ],
        [
          1435.0,
          1764.0
        ],
        [
          538.0,
          1764.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "在每個子層的計算中，會對其輸出進行歸一化（Normalization）處理，使該層的特徵在不同維度上具有相對穩定的均值與變異數。",
      "block_bbox": [
        593,
        1803,
        2077,
        2066
      ],
      "block_id": 10,
      "block_order": 10,
      "group_id": 10,
      "block_polygon_points": [
        [
          593.0,
          1803.0
        ],
        [
          2077.0,
          1803.0
        ],
        [
          2077.0,
          2066.0
        ],
        [
          593.0,
          2066.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "○ 相較於批次歸一化（Batch Normalization），層歸一化不依賴批次大小，因此特別適合自然語言處理這類序列模型。",
      "block_bbox": [
        591,
        2104,
        2079,
        2265
      ],
      "block_id": 11,
      "block_order": 11,
      "group_id": 11,
      "block_polygon_points": [
        [
          591.0,
          2104.0
        ],
        [
          2079.0,
          2104.0
        ],
        [
          2079.0,
          2265.0
        ],
        [
          591.0,
          2265.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "○ 層歸一化能有效穩定訓練過程，避免數值發散，並減少內部協變偏移（Internal Covariate Shift, ICS）。",
      "block_bbox": [
        592,
        2304,
        2081,
        2466
      ],
      "block_id": 12,
      "block_order": 12,
      "group_id": 12,
      "block_polygon_points": [
        [
          592.0,
          2304.0
        ],
        [
          2081.0,
          2304.0
        ],
        [
          2081.0,
          2466.0
        ],
        [
          592.0,
          2466.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "內部協變偏移（Internal Covariate Shift, ICS）：隨著訓練進行，前面層的參數不斷更新，導致後續層的輸入分布不斷改變，這會迫使模型的每一層必須不停重新適應新的輸入分布，降低訓練效率並延緩收斂。",
      "block_bbox": [
