      ]
    },
    {
      "block_label": "text",
      "block_content": "■ 前饋網路（Feed-Forward Network）是相對簡單的、由兩個線性層構成的全連接網路（中間包含一個激活函數，如 ReLU）。",
      "block_bbox": [
        536,
        703,
        2080,
        867
      ],
      "block_id": 3,
      "block_order": 3,
      "group_id": 3,
      "block_polygon_points": [
        [
          536.0,
          703.0
        ],
        [
          2080.0,
          703.0
        ],
        [
          2080.0,
          867.0
        ],
        [
          536.0,
          867.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "■ 對序列中每個位置的輸出獨立且相同地應用這個網路，用於進一步轉換和處理注意力層所提取的資訊。",
      "block_bbox": [
        535,
        902,
        2076,
        1061
      ],
      "block_id": 4,
      "block_order": 4,
      "group_id": 4,
