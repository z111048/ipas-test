                ],
                [
                    397.0,
                    1163.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ P(A|B)=\\frac{P(A\\cap B)}{P(B)} $$ ",
            "block_bbox": [
                397,
                1202,
                816,
                1326
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    397.0,
                    1202.0
                ],
                [
                    816.0,
                    1202.0
                ],
                [
                    816.0,
                    1326.0
                ],
                [
                    397.0,
                    1326.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "表示在事件 B 發生的前提下，事件 A 發生的機率。這種推論形式在分類、推薦、風險預測等領域皆有廣泛應用。以下舉例條件機率在機器學習中的應用場景：",
            "block_bbox": [
                297,
                1368,
                2081,
                1528
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    297.0,
                    1368.0
                ],
                [
                    2081.0,
                    1368.0
                ],
                [
                    2081.0,
                    1528.0
                ],
                [
                    297.0,
                    1528.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "分類任務中的條件預測：模型的任務通常是學習條件機率  $ P(Y \\mid X) $，即在觀察輸入特徵 X 的情況下，預測 Y 的可能性分佈。像是邏輯迴歸、貝氏分類器等，皆以此為核心。",
            "block_bbox": [
                398,
                1566,
                2080,
                1826
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    398.0,
                    1566.0
                ],
                [
                    2080.0,
                    1566.0
                ],
                [
                    2080.0,
                    1826.0
                ],
                [
                    398.0,
                    1826.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "生醫與金融風控領域的風險預測：當已知某些檢驗結果或行為模式，條件機率可協助預估未來事件發生的可能性，例如罹病風險、違約機率等。",
            "block_bbox": [
                399,
                1866,
                2078,
                2027
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    399.0,
                    1866.0
                ],
                [
                    2078.0,
                    1866.0
                ],
                [
                    2078.0,
                    2027.0
                ],
                [
                    399.0,
                    2027.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "生成模型中的變數關聯建構：在變分自編碼器或隱馬可夫模型（Hidden Markov Model, HMM）中，條件機率用於建構潛在變數與觀察變數間的依存關係。",
            "block_bbox": [
                398,
