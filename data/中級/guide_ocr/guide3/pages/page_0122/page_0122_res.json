    {
      "block_label": "text",
      "block_content": "如 Longformer, Reformer, Performer 等，這類型模型旨在解決原始 Transformer 中自注意力機制計算複雜度與序列長度平方成正比  $ O(L^{2}) $ 的問題。",
      "block_bbox": [
        525,
        1805,
        2084,
        2066
      ],
      "block_id": 10,
      "block_order": 10,
      "group_id": 10,
      "block_polygon_points": [
