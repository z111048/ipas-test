          533.0,
          1063.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "則： $ P(X|C) = P(x_1|C) \\times P(x_2|C) \\times \\ldots \\times P(x_n|C) $",
      "block_bbox": [
        528,
        1100,
