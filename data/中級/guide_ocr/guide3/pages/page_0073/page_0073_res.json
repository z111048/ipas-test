        ],
        [
          532.0,
          963.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "若  $ X = (x_1, x_2, \\ldots, x_n) $ 是一組特徵",
      "block_bbox": [
        533,
        1001,
        1344,
        1063
      ],
      "block_id": 5,
      "block_order": 5,
      "group_id": 5,
      "block_polygon_points": [
