      ]
    },
    {
      "block_label": "text",
      "block_content": "♦ 遞迴神經網路是一種專門設計用於處理可變長度序列輸入數據（Sequential Data）的深度學習模型。",
      "block_bbox": [
        475,
        1290,
        2080,
        1454
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
      "block_polygon_points": [
        [
          475.0,
