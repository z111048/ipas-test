          1202.0
        ],
        [
          2082.0,
          1362.0
        ],
        [
          356.0,
          1362.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "NPV =  $ \\Sigma $（每期現金流 /  $ 1 + \\text{折現率} $）^期數） - 初期投資",
      "block_bbox": [
        417,
        1403,
