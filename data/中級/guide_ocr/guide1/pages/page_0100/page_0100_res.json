    {
      "block_label": "text",
      "block_content": "定義：NPV是一個用來評估長期投資專案的財務模型，計算的是未來現金流量的折現總和，減去初期投資成本。",
      "block_bbox": [
        356,
        1202,
        2082,
        1362
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
      "block_polygon_points": [
        [
          356.0,
          1202.0
