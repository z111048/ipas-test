                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "AI 導入評估的核心目的，是判斷導入是否具有實質價值與可行性。此階段不僅聚焦於技術是否可實現，更需關注其是否能解決企業當前痛點、與業務目標契合，並具備合理的成本效益。透過結構化的評估過程，可避免資源浪費與決策失誤，確保後續導入步驟建立在穩健基礎之上。",
            "block_bbox": [
                292,
                1317,
                2081,
                1679
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
