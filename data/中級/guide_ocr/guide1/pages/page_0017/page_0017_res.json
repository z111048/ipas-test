        },
        {
            "block_label": "text",
            "block_content": "因此，資料在餵入模型之前，必須先經過一系列清理、轉換與標準化的處理，以便機器能有效理解與運算。以下是 NLP 前處理常見技術，在實務應用中，依任務需求、這些步驟常以不同順序或深度搭配執行。",
            "block_bbox": [
                296,
                903,
                2082,
                1167
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
