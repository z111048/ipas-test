        {
            "block_label": "text",
            "block_content": "專為技術團隊設計的任務追蹤工具，特別適合資料科學家與工程師主導的 AI 專案。其功能包括問題追蹤(Issue Tracking)、工作流自訂與敏捷開發支援(如 Scrum 與 Kanban)。",
            "block_bbox": [
                296,
                904,
                2086,
                1160
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
