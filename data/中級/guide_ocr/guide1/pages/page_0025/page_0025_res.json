    {
      "block_label": "text",
      "block_content": "N-grams：是將語言中的「連續 N 個詞、組合成一個特徵單位」，用來保留詞彙的序列與語法結構。N-grams 的大小（即 N 的值）決定了模型能捕捉到的上下文範圍，較大的 N 值能夠保留更長距離的語境資訊，但也會引入更多的特徵。",
      "block_bbox": [
        298,
        1519,
        2081,
        1786
      ],
      "block_id": 11,
      "block_order": 11,
      "group_id": 11,
      "block_polygon_points": [
        [
          298.0,
          1519.0
