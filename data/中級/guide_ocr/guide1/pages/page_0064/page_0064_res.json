          2078.0,
          1266.0
        ],
        [
          296.0,
          1266.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "資料來源不平衡：例如，訓練資料集中某些族群（如膚色、性別、年齡）過於集中，造成模型對其他族群的辨識準確度較低。",
      "block_bbox": [
        298,
        1303,
        2078,
        1465
      ],
      "block_id": 6,
      "block_order": 6,
      "group_id": 6,
