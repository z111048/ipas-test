    {
      "block_label": "paragraph_title",
      "block_content": "B. 分布式表示與非分布式表示",
      "block_bbox": [
        297,
        1203,
        995,
        1262
      ],
      "block_id": 3,
      "block_order": 3,
      "group_id": 3,
      "block_polygon_points": [
        [
          297.0,
