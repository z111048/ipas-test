                    2080.0,
                    2104.0
                ],
                [
                    2080.0,
                    2264.0
                ],
                [
                    358.0,
                    2264.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "資料可攜權（Data Portability）：根據 GDPR 第 20 條，資料主體有權要求企業以結構化、通用且可機器讀取的格式提供其個人資料，並可將資料轉移至其他服務提供者。",
            "block_bbox": [
                358,
                2303,
                2082,
                2565
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
