                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "在傳統 RNN 中，模型需逐字（token by token）讀取序列，難以捕捉長距離語意。",
            "block_bbox": [
                476,
                1103,
                2080,
                1262
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
