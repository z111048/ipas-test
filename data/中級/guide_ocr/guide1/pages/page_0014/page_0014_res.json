            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "C. 第三階段：深度學習時代（2010s）",
            "block_bbox": [
                299,
                1904,
                1137,
                1962
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    299.0,
