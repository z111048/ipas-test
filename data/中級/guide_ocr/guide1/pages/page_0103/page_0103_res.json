        {
            "block_label": "text",
            "block_content": "AI系統運作高度依賴資料，若未妥善處理個人資料或敏感資訊，將面臨法規違規、名譽受損等後果：",
            "block_bbox": [
                297,
                1302,
                2082,
                1464
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    297.0,
