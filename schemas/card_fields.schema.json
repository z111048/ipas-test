{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "解說圖卡欄位重生",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concept", "mnemonic", "confusion"],
        "properties": {
          "id": {
            "type": "string",
            "description": "原題目的 id，必須與 prompt 中給的完全一致"
          },
          "concept": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120,
            "description": "這題考的核心觀念，一句話；不得抄答案選項原句"
          },
          "mnemonic": {
            "type": "string",
            "minLength": 6,
            "maxLength": 120,
            "description": "好記的口訣或聯想，不得包含錯誤陳述"
          },
          "confusion": {
            "type": "string",
            "minLength": 12,
            "maxLength": 160,
            "description": "最容易混淆的一組概念及其差別；不得複製解析"
          }
        }
      }
    }
  }
}
