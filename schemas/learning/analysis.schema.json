{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/analysis.schema.json",
  "title": "Exam analysis contracts",
  "$defs": {
    "sessionKey": { "type": "string", "pattern": "^roc-[0-9]{3,}-r[0-9]{2}$" },
    "analysisPolicy": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "levelIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/levelId" }, "uniqueItems": true }, "subjectIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["official", "sample"] }, "uniqueItems": true }, "examKeys": { "type": "array", "items": { "$ref": "#/$defs/examKey" } }, "fromSession": { "$ref": "#/$defs/sessionKey" }, "toSession": { "$ref": "#/$defs/sessionKey" }, "mappingPolicy": { "enum": ["source_bound_strict_v1", "legacy_strict_v1"] }, "unit": { "enum": ["occurrence", "family"] }, "answerPolicy": { "enum": ["include_with_status", "verified_only"] } }, "required": ["id", "revision", "levelIds", "subjectIds", "kinds", "examKeys", "mappingPolicy", "unit", "answerPolicy"], "additionalProperties": false },
    "examKey": { "type": "object", "properties": { "levelId": { "$ref": "common.schema.json#/$defs/levelId" }, "key": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["levelId", "key"], "additionalProperties": false },
    "inventoryRow": { "type": "object", "properties": { "levelId": { "$ref": "common.schema.json#/$defs/levelId" }, "examKey": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["official", "sample"] }, "expected": { "type": ["integer", "null"], "minimum": 0 }, "present": { "type": "integer", "minimum": 0 }, "labelReviewed": { "type": "integer", "minimum": 0 }, "answerDisputed": { "type": "integer", "minimum": 0 } }, "required": ["levelId", "examKey", "kind", "expected", "present", "labelReviewed", "answerDisputed"], "additionalProperties": false },
    "missingSession": { "type": "object", "properties": { "session": { "$ref": "#/$defs/sessionKey" }, "reason": { "enum": ["not_available", "not_ingested", "unknown"] } }, "required": ["session", "reason"], "additionalProperties": false },
    "publicationCoverage": { "type": "object", "properties": { "sessionsKnown": { "type": "array", "items": { "$ref": "#/$defs/sessionKey" }, "uniqueItems": true }, "sessionsIncluded": { "type": "array", "items": { "$ref": "#/$defs/sessionKey" }, "uniqueItems": true }, "missingSessions": { "type": "array", "items": { "$ref": "#/$defs/missingSession" } }, "exhaustive": { "type": "boolean" }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["sessionsKnown", "sessionsIncluded", "missingSessions", "exhaustive", "evidenceIds"], "additionalProperties": false },
    "measure": { "type": "object", "properties": { "scopeKey": { "$ref": "common.schema.json#/$defs/identifier" }, "topic": { "$ref": "common.schema.json#/$defs/topicRef" }, "population": { "type": "integer", "minimum": 0 }, "reviewed": { "type": "integer", "minimum": 0 }, "matched": { "type": "integer", "minimum": 0 }, "unknown": { "type": "integer", "minimum": 0 }, "prevalence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "reviewedPrevalence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "lowerBound": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "upperBound": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }, "required": ["scopeKey", "topic", "population", "reviewed", "matched", "unknown", "prevalence", "reviewedPrevalence", "lowerBound", "upperBound"], "additionalProperties": false },
    "exclusion": { "type": "object", "properties": { "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 0 } }, "required": ["reason", "count"], "additionalProperties": false },
    "examAnalysis": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "policy": { "$ref": "#/$defs/analysisPolicy" }, "policyHash": { "$ref": "common.schema.json#/$defs/hash" }, "catalogHash": { "$ref": "common.schema.json#/$defs/hash" }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "taxonomyHash": { "$ref": "common.schema.json#/$defs/hash" }, "labelReviewHash": { "$ref": "common.schema.json#/$defs/hash" }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventoryRow" } }, "publicationCoverage": { "$ref": "#/$defs/publicationCoverage" }, "measures": { "type": "array", "items": { "$ref": "#/$defs/measure" } }, "exclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } } }, "required": ["schemaVersion", "id", "policy", "policyHash", "catalogHash", "contentHash", "taxonomyHash", "labelReviewHash", "releaseId", "inventory", "publicationCoverage", "measures", "exclusions"], "additionalProperties": false }
  }
}
