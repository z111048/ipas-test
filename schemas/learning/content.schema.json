{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/content.schema.json",
  "title": "Learning content contracts",
  "$defs": {
    "objective": { "type": "object", "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*::[A-Za-z0-9][A-Za-z0-9._:-]*$" }, "action": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "condition": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "criterion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "assessmentIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["id", "action", "condition", "criterion", "assessmentIds"], "additionalProperties": false },
    "learningUnit": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/envelopeFields" }],
      "type": "object",
      "properties": { "schemaVersion": true, "id": true, "revision": true, "contentHash": true, "status": true, "reviewIds": true, "dependencies": true, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "summary": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "bodyRef": { "$ref": "common.schema.json#/$defs/safePath" }, "levelIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/levelId" }, "uniqueItems": true }, "chapterRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/chapterRef" } }, "topicRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/topicRef" } }, "guideRefs": { "type": "array", "minItems": 1, "items": { "$ref": "identity.schema.json#/$defs/guideRef" } }, "gapStatement": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objective" } }, "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } }, "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }, "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unitSection" } }, "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }, "assessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessment" } }, "rubrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rubric" } }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "labRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityRef" } }, "projectRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityRef" } } },
      "required": ["title", "summary", "bodyRef", "levelIds", "chapterRefs", "topicRefs", "guideRefs", "gapStatement", "objectives", "prerequisites", "estimatedMinutes", "sections", "claims", "assessments", "rubrics", "evidenceIds", "labRefs", "projectRefs"],
      "unevaluatedProperties": false
    },
    "prerequisite": { "type": "object", "properties": { "kind": { "enum": ["unit", "skill"] }, "ref": { "$ref": "common.schema.json#/$defs/identifier" }, "diagnosticPrompt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "remediationRef": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["kind", "ref", "diagnosticPrompt", "remediationRef"], "additionalProperties": false },
    "unitSection": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["context", "concept_bridge", "worked_example", "guided_practice", "independent_practice", "misconceptions", "assessment_reflection"] }, "bodyAnchor": { "$ref": "common.schema.json#/$defs/identifier" }, "objectiveIds": { "type": "array", "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "claimIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["id", "kind", "bodyAnchor", "objectiveIds", "claimIds"], "additionalProperties": false },
    "qualifiedObjectiveId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*::[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "claim": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["source", "editorial", "example"] }, "text": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "sourceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourceSnapshot" } } }, "required": ["id", "kind", "text", "sourceRefs"], "additionalProperties": false },
    "assessment": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "$ref": "common.schema.json#/$defs/identifier" }, "prompt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "objectiveIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "expectedEvidence": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "rubricId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["id", "kind", "prompt", "objectiveIds", "expectedEvidence", "rubricId"], "additionalProperties": false },
    "rubric": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rubricCriterion" } } }, "required": ["id", "criteria"], "additionalProperties": false },
    "rubricCriterion": { "type": "object", "properties": { "criterion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "passEvidence": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "required": ["criterion", "passEvidence"], "additionalProperties": false },
    "pathTarget": { "oneOf": [
      { "type": "object", "properties": { "kind": { "enum": ["unit", "project", "lab"] }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["kind", "id", "revision", "hash"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "const": "article" }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["kind", "id", "contentHash"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "const": "guide" }, "ref": { "$ref": "identity.schema.json#/$defs/guideRef" } }, "required": ["kind", "ref"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "const": "practice" }, "chapter": { "$ref": "common.schema.json#/$defs/chapterRef" }, "practiceSet": { "enum": ["chapter", "guide"] }, "questions": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/questionRef" } } }, "required": ["kind", "chapter", "practiceSet", "questions"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "const": "simulation" }, "blueprintId": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["kind", "blueprintId", "revision", "hash"], "additionalProperties": false }
    ] },
    "pathStep": { "type": "object", "properties": { "stepId": { "$ref": "common.schema.json#/$defs/identifier" }, "target": { "$ref": "#/$defs/pathTarget" }, "required": { "type": "boolean" }, "prerequisiteStepIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["stepId", "target", "required", "prerequisiteStepIds"], "additionalProperties": false },
    "learningPath": { "allOf": [{ "$ref": "common.schema.json#/$defs/envelopeFields" }], "type": "object", "properties": { "schemaVersion": true, "id": true, "revision": true, "contentHash": true, "status": true, "reviewIds": true, "dependencies": true, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "audience": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pathStep" } } }, "required": ["title", "audience", "outcomes", "steps"], "unevaluatedProperties": false },
    "project": { "allOf": [{ "$ref": "common.schema.json#/$defs/envelopeFields" }], "type": "object", "properties": { "schemaVersion": true, "id": true, "revision": true, "contentHash": true, "status": true, "reviewIds": true, "dependencies": true, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "brief": { "$ref": "#/$defs/projectBrief" }, "topicRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/topicRef" } }, "chapterRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/chapterRef" } }, "unitRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/entityRef" } }, "labRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityRef" } }, "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestone" } }, "rubric": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weightedCriterion" } }, "deliverables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/deliverable" } } }, "required": ["title", "brief", "topicRefs", "chapterRefs", "unitRefs", "labRefs", "milestones", "rubric", "deliverables"], "unevaluatedProperties": false },
    "projectBrief": { "type": "object", "properties": { "scenario": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "problemStatement": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "constraints": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "required": ["scenario", "problemStatement", "constraints"], "additionalProperties": false },
    "milestone": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "requiredUnitIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "task": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "deliverableIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "prerequisiteIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "required": ["id", "title", "requiredUnitIds", "task", "deliverableIds", "prerequisiteIds", "acceptanceCriteria"], "additionalProperties": false },
    "weightedCriterion": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "criterion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "passEvidence": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "required": ["id", "criterion", "weight", "passEvidence"], "additionalProperties": false },
    "deliverable": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "format": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "requiredFields": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true }, "maxBytes": { "type": "integer", "minimum": 1 }, "rubricCriterionIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["id", "format", "requiredFields", "maxBytes", "rubricCriterionIds"], "additionalProperties": false },
    "lab": { "allOf": [{ "$ref": "common.schema.json#/$defs/envelopeFields" }], "type": "object", "properties": { "schemaVersion": true, "id": true, "revision": true, "contentHash": true, "status": true, "reviewIds": true, "dependencies": true, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "unitRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/entityRef" } }, "chapterRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/chapterRef" } }, "topicRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/topicRef" } }, "objectiveIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "sourceNotebookRef": { "type": "string", "pattern": "^notebooks/labs/[A-Za-z0-9][A-Za-z0-9._:-]*\\.ipynb$" }, "notebookHash": { "$ref": "common.schema.json#/$defs/hash" }, "environment": { "$ref": "#/$defs/labEnvironment" }, "executionPolicy": { "$ref": "#/$defs/executionPolicy" }, "datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/labStep" } }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/labCheck" } }, "rubric": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rubricCriterion" } }, "reflectionPrompts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/labArtifact" }, "maxItems": 2 }, "executionReviewId": { "$ref": "common.schema.json#/$defs/identifier" }, "semanticReviewId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["title", "unitRefs", "chapterRefs", "topicRefs", "objectiveIds", "sourceNotebookRef", "notebookHash", "environment", "executionPolicy", "datasets", "steps", "checks", "rubric", "reflectionPrompts", "artifacts"], "unevaluatedProperties": false },
    "labEnvironment": { "type": "object", "properties": { "pythonVersion": { "type": "string", "pattern": "^3\\.[0-9]+(?:\\.[0-9]+)?$" }, "lockRef": { "$ref": "common.schema.json#/$defs/safePath" }, "lockHash": { "$ref": "common.schema.json#/$defs/hash" }, "kernelName": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "runtimeProfile": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 } }, "required": ["pythonVersion", "lockRef", "lockHash", "kernelName", "runtimeProfile", "seed"], "additionalProperties": false },
    "executionPolicy": { "type": "object", "properties": { "cpuOnly": { "const": true }, "maxMemoryMb": { "type": "integer", "minimum": 128 }, "cellTimeoutSeconds": { "type": "integer", "minimum": 1 }, "totalTimeoutSeconds": { "type": "integer", "minimum": 1 }, "networkPolicy": { "enum": ["offline", "approved_resources"] } }, "required": ["cpuOnly", "maxMemoryMb", "cellTimeoutSeconds", "totalTimeoutSeconds", "networkPolicy"], "additionalProperties": false },
    "dataset": { "type": "object", "properties": { "resource": { "$ref": "common.schema.json#/$defs/resourceRef" }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "fallbackResource": { "$ref": "common.schema.json#/$defs/resourceRef" } }, "required": ["resource", "hash", "version"], "additionalProperties": false },
    "labPhase": { "enum": ["setup", "worked", "guided", "independent", "check", "reflection"] },
    "learningCellMetadata": { "type": "object", "properties": { "labId": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "cellId": { "$ref": "common.schema.json#/$defs/identifier" }, "phase": { "$ref": "#/$defs/labPhase" }, "objectiveIds": { "type": "array", "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "audience": { "enum": ["both", "solution"] }, "starterSource": { "type": "string" } }, "required": ["labId", "revision", "cellId", "phase", "objectiveIds", "audience"], "additionalProperties": false },
    "labStep": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "phase": { "$ref": "#/$defs/labPhase" }, "cellIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "objectiveIds": { "type": "array", "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "estimatedMinutes": { "type": "integer", "minimum": 1 }, "expectedArtifacts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "required": ["id", "phase", "cellIds", "objectiveIds", "estimatedMinutes", "expectedArtifacts"], "additionalProperties": false },
    "labCheck": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "objectiveIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualifiedObjectiveId" }, "uniqueItems": true }, "artifactRef": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "predicate": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "tolerance": { "type": "number", "minimum": 0 }, "bounds": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 }, "severity": { "enum": ["block", "warn"] } }, "required": ["id", "objectiveIds", "artifactRef", "predicate", "severity"], "additionalProperties": false },
    "labArtifact": { "type": "object", "properties": { "variant": { "enum": ["starter", "solution"] }, "path": { "$ref": "common.schema.json#/$defs/safePath" }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "revision": { "type": "integer", "minimum": 1 }, "size": { "type": "integer", "minimum": 1, "maximum": 2097152 } }, "required": ["variant", "path", "hash", "revision", "size"], "additionalProperties": false }
  }
}
