{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/mock.schema.json",
  "title": "Mock exam contracts",
  "$defs": {
    "poolRef": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "hash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["id", "releaseId", "hash"], "additionalProperties": false },
    "poolQuestion": { "type": "object", "properties": { "question": { "$ref": "common.schema.json#/$defs/questionRef" }, "payloadPath": { "$ref": "common.schema.json#/$defs/safePath" }, "fileHash": { "$ref": "common.schema.json#/$defs/hash" }, "identityReview": { "const": "verified" }, "mappingReviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "difficultyReviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["question", "payloadPath", "fileHash", "identityReview", "mappingReviewIds", "difficultyReviewIds"], "additionalProperties": false },
    "poolGroup": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "members": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/questionRef" } } }, "required": ["id", "revision", "hash", "members"], "additionalProperties": false },
    "mockPool": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "policyHash": { "$ref": "common.schema.json#/$defs/hash" }, "annotationSnapshotHash": { "$ref": "common.schema.json#/$defs/hash" }, "questions": { "type": "array", "items": { "$ref": "#/$defs/poolQuestion" } }, "groups": { "type": "array", "items": { "$ref": "#/$defs/poolGroup" } } }, "required": ["schemaVersion", "id", "releaseId", "contentHash", "policyHash", "annotationSnapshotHash", "questions", "groups"], "additionalProperties": false },
    "quota": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "dimension": { "enum": ["topic", "chapter", "difficulty"] }, "key": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 }, "mode": { "enum": ["hard", "soft"] }, "priority": { "type": "integer", "minimum": 0 } }, "required": ["id", "dimension", "key", "min", "max", "mode", "priority"], "additionalProperties": false },
    "mockBlueprint": { "allOf": [{ "$ref": "common.schema.json#/$defs/envelopeFields" }], "type": "object", "properties": { "schemaVersion": true, "id": true, "revision": true, "contentHash": true, "status": true, "reviewIds": true, "dependencies": true, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "levelId": { "$ref": "common.schema.json#/$defs/levelId" }, "subjectIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "questionCount": { "type": "integer", "minimum": 1 }, "timeLimitSeconds": { "type": "integer", "minimum": 1 }, "poolRef": { "$ref": "#/$defs/poolRef" }, "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["official", "sample", "chapter_practice", "guide_exercise"] }, "uniqueItems": true }, "format": { "const": "single_choice" }, "quotas": { "type": "array", "items": { "$ref": "#/$defs/quota" } }, "seedPolicy": { "const": "user_or_generated" }, "algorithmVersion": { "const": "mock-selector-v1" }, "uniqueFamily": { "const": true }, "contextPolicy": { "const": "atomic_keep_order" }, "optionOrder": { "enum": ["fixed", "seeded"] }, "scoring": { "$ref": "#/$defs/scoring" } }, "required": ["title", "levelId", "subjectIds", "questionCount", "timeLimitSeconds", "poolRef", "kinds", "format", "quotas", "seedPolicy", "algorithmVersion", "uniqueFamily", "contextPolicy", "optionOrder", "scoring"], "unevaluatedProperties": false },
    "scoring": { "type": "object", "properties": { "correct": { "type": "number" }, "incorrect": { "const": 0 }, "unanswered": { "const": 0 }, "passingPercent": { "type": "number", "minimum": 0, "maximum": 100 } }, "required": ["correct", "incorrect", "unanswered", "passingPercent"], "additionalProperties": false },
    "slotAssignment": { "type": "object", "properties": { "question": { "$ref": "common.schema.json#/$defs/questionRef" }, "dimension": { "enum": ["topic", "chapter", "difficulty"] }, "quotaId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["question", "dimension", "quotaId"], "additionalProperties": false },
    "displayedOptions": { "type": "object", "properties": { "question": { "$ref": "common.schema.json#/$defs/questionRef" }, "optionIds": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "uniqueItems": true } }, "required": ["question", "optionIds"], "additionalProperties": false },
    "unmetConstraint": { "type": "object", "properties": { "rule": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "required": { "type": "integer", "minimum": 0 }, "eligible": { "type": "integer", "minimum": 0 } }, "required": ["rule", "required", "eligible"], "additionalProperties": false },
    "assemblyResult": { "oneOf": [
      { "type": "object", "properties": { "status": { "const": "ready" }, "formId": { "type": "string", "pattern": "^form-[0-9a-f]{64}$" }, "seed": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "blueprintHash": { "$ref": "common.schema.json#/$defs/hash" }, "poolRef": { "$ref": "#/$defs/poolRef" }, "poolHash": { "$ref": "common.schema.json#/$defs/hash" }, "selectedQuestionRevisions": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/questionRef" } }, "slotAssignments": { "type": "array", "items": { "$ref": "#/$defs/slotAssignment" } }, "displayedOptionIds": { "type": "array", "items": { "$ref": "#/$defs/displayedOptions" } }, "softMisses": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["status", "formId", "seed", "blueprintHash", "poolRef", "poolHash", "selectedQuestionRevisions", "slotAssignments", "displayedOptionIds", "softMisses"], "additionalProperties": false },
      { "type": "object", "properties": { "status": { "enum": ["insufficient_pool", "unsupported_format", "stale_pool"] }, "reason": { "enum": ["unsatisfied_constraints", "search_limit", "unsupported_format", "stale_pool"] }, "unmet": { "type": "array", "items": { "$ref": "#/$defs/unmetConstraint" } }, "suggestions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "required": ["status", "reason", "unmet", "suggestions"], "additionalProperties": false }
    ] }
  }
}
