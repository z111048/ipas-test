{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/common.schema.json",
  "title": "iPAS learning platform common contract types",
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "utcTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" },
    "levelId": { "enum": ["junior", "middle"] },
    "state": { "enum": ["draft", "in_review", "published", "retired"] },
    "resourceRef": { "type": "object", "properties": { "namespace": { "enum": ["exam", "resource"] }, "levelId": { "$ref": "#/$defs/levelId" }, "key": { "$ref": "#/$defs/identifier" } }, "required": ["namespace", "key"], "additionalProperties": false },
    "capture": { "type": "object", "properties": { "mode": { "enum": ["permitted_excerpt", "authored_summary"] }, "text": { "$ref": "#/$defs/nonEmptyString" } }, "required": ["mode", "text"], "additionalProperties": false },
    "sourceSnapshot": {
      "type": "object",
      "properties": { "resource": { "$ref": "#/$defs/resourceRef" }, "revision": { "$ref": "#/$defs/nonEmptyString" }, "hash": { "$ref": "#/$defs/hash" }, "selector": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "enum": ["repository", "external"] }, "hashScope": { "enum": ["full_artifact", "reviewed_capture"] }, "artifactPath": { "$ref": "#/$defs/safePath" }, "retrievedAt": { "$ref": "#/$defs/utcTimestamp" }, "reviewDueAt": { "$ref": "#/$defs/utcTimestamp" }, "capture": { "$ref": "#/$defs/capture" } },
      "required": ["resource", "revision", "hash", "kind", "hashScope"],
      "oneOf": [
        { "properties": { "kind": { "const": "repository" }, "hashScope": { "const": "full_artifact" } }, "required": ["artifactPath"], "not": { "anyOf": [{ "required": ["retrievedAt"] }, { "required": ["reviewDueAt"] }, { "required": ["capture"] }] } },
        { "properties": { "kind": { "const": "external" }, "hashScope": { "const": "reviewed_capture" } }, "required": ["retrievedAt", "reviewDueAt", "capture"] }
      ],
      "additionalProperties": false
    },
    "chapterRef": { "type": "object", "properties": { "levelId": { "$ref": "#/$defs/levelId" }, "subjectId": { "$ref": "#/$defs/identifier" }, "chapterId": { "$ref": "#/$defs/identifier" } }, "required": ["levelId", "subjectId", "chapterId"], "additionalProperties": false },
    "topicRef": { "type": "object", "properties": { "id": { "$ref": "#/$defs/identifier" }, "name": { "$ref": "#/$defs/nonEmptyString" } }, "required": ["id", "name"], "additionalProperties": false },
    "entityRef": { "type": "object", "properties": { "kind": { "enum": ["unit", "project", "path", "lab"] }, "id": { "$ref": "#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "id", "revision"], "additionalProperties": false },
    "questionRef": { "type": "object", "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "#/$defs/hash" } }, "required": ["questionKey", "revision", "hash"], "additionalProperties": false },
    "evidenceRef": { "type": "object", "properties": { "id": { "$ref": "#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "#/$defs/hash" } }, "required": ["id", "revision", "hash"], "additionalProperties": false },
    "subjectRef": { "type": "object", "properties": { "kind": { "$ref": "#/$defs/identifier" }, "id": { "$ref": "#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "hash": { "$ref": "#/$defs/hash" } }, "required": ["kind", "id", "revision", "hash"], "additionalProperties": false },
    "option": { "type": "object", "properties": { "optionId": { "type": "string", "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "text": { "$ref": "#/$defs/nonEmptyString" } }, "required": ["optionId", "text"], "additionalProperties": false },
    "envelopeFields": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "#/$defs/hash" }, "status": { "$ref": "#/$defs/state" }, "reviewIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }, "dependencies": { "type": "array", "items": { "$ref": "#/$defs/sourceSnapshot" } } }, "required": ["schemaVersion", "id", "revision", "contentHash", "status", "reviewIds", "dependencies"] }
  }
}
