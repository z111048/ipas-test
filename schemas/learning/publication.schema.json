{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/publication.schema.json",
  "title": "Lifecycle and publication contracts",
  "$defs": {
    "lifecycleEvent": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "subject": { "$ref": "common.schema.json#/$defs/subjectRef" }, "from": { "$ref": "common.schema.json#/$defs/state" }, "to": { "$ref": "common.schema.json#/$defs/state" }, "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "reviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "createdAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" } }, "required": ["id", "subject", "from", "to", "reason", "reviewIds", "createdAt"], "allOf": [{ "if": { "properties": { "to": { "const": "retired" } }, "required": ["to"] }, "then": { "properties": { "reviewIds": { "minItems": 1 } } } }], "additionalProperties": false },
    "publicationError": { "type": "object", "properties": { "code": { "$ref": "common.schema.json#/$defs/identifier" }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["code", "evidenceIds"], "additionalProperties": false },
    "publicationResult": { "oneOf": [{ "type": "object", "properties": { "status": { "const": "published" }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["status", "releaseId"], "additionalProperties": false }, { "type": "object", "properties": { "status": { "const": "blocked" }, "failedStage": { "$ref": "#/$defs/gateStage" }, "affectedIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "errors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/publicationError" } } }, "required": ["status", "failedStage", "affectedIds", "errors"], "additionalProperties": false }] },
    "gateStage": { "enum": ["schema", "references", "review", "execution", "integrity", "commit"] },
    "releaseEntity": { "type": "object", "properties": { "kind": { "$ref": "common.schema.json#/$defs/identifier" }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "path": { "$ref": "common.schema.json#/$defs/safePath" } }, "required": ["kind", "id", "revision", "contentHash", "path"], "additionalProperties": false },
    "releaseFile": { "type": "object", "properties": { "path": { "$ref": "common.schema.json#/$defs/safePath" }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "size": { "type": "integer", "minimum": 0 } }, "required": ["path", "hash", "size"], "additionalProperties": false },
    "releaseGate": { "type": "object", "properties": { "stage": { "$ref": "#/$defs/gateStage" }, "status": { "enum": ["passed", "failed", "not_run"] }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["stage", "status", "evidenceIds"], "additionalProperties": false },
    "releaseManifest": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "availability": { "enum": ["preview", "published"] }, "exporterVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "inputHashes": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "common.schema.json#/$defs/safePath" }, "additionalProperties": { "$ref": "common.schema.json#/$defs/hash" } }, "entities": { "type": "array", "items": { "$ref": "#/$defs/releaseEntity" } }, "files": { "type": "array", "items": { "$ref": "#/$defs/releaseFile" } }, "gates": { "type": "array", "items": { "$ref": "#/$defs/releaseGate" } } }, "required": ["schemaVersion", "releaseId", "availability", "exporterVersion", "inputHashes", "entities", "files", "gates"], "additionalProperties": false },
    "releasePointer": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "availability": { "enum": ["preview", "published"] }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "manifestPath": { "$ref": "common.schema.json#/$defs/safePath" } }, "required": ["schemaVersion", "availability", "releaseId", "manifestPath"], "additionalProperties": false }
  }
}
