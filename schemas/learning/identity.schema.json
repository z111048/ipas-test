{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/identity.schema.json",
  "title": "Question and guide identity contracts",
  "$defs": {
    "questionIdentity": { "type": "object", "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "levelId": { "$ref": "common.schema.json#/$defs/levelId" }, "sourceKey": { "$ref": "common.schema.json#/$defs/identifier" }, "legacyId": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["official", "sample", "chapter_practice", "guide_exercise"] }, "sourcePath": { "$ref": "common.schema.json#/$defs/safePath" }, "sourceNumber": { "type": "integer", "minimum": 1 }, "chapterRef": { "$ref": "common.schema.json#/$defs/chapterRef" }, "familyId": { "$ref": "common.schema.json#/$defs/identifier" }, "identityReview": { "enum": ["legacy_unverified", "verified"] } }, "required": ["questionKey", "levelId", "sourceKey", "legacyId", "kind", "sourcePath", "familyId", "identityReview"], "additionalProperties": false },
    "questionAsset": { "type": "object", "properties": { "resource": { "$ref": "common.schema.json#/$defs/resourceRef" }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "placement": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "answerLeakReviewId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["resource", "hash", "placement", "answerLeakReviewId"], "additionalProperties": false },
    "questionRevision": {
      "type": "object",
      "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "format": { "const": "single_choice" }, "stem": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/option" } }, "correctOptionId": { "type": "string", "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "explanation": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "answerStatus": { "enum": ["legacy_unverified", "verified", "disputed", "withdrawn"] }, "contextGroupId": { "$ref": "common.schema.json#/$defs/identifier" }, "contextGroupRevision": { "type": "integer", "minimum": 1 }, "contextHash": { "$ref": "common.schema.json#/$defs/hash" }, "sourceOrder": { "type": "integer", "minimum": 1 }, "difficulty": { "$ref": "#/$defs/questionDifficulty" }, "assets": { "type": "array", "items": { "$ref": "#/$defs/questionAsset" } }, "reviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "sourceHashes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/hash" }, "uniqueItems": true } },
      "required": ["questionKey", "revision", "contentHash", "format", "stem", "options", "correctOptionId", "explanation", "answerStatus", "assets", "reviewIds", "sourceHashes"],
      "dependentRequired": { "contextGroupId": ["contextGroupRevision", "contextHash", "sourceOrder"], "contextGroupRevision": ["contextGroupId", "contextHash", "sourceOrder"], "contextHash": ["contextGroupId", "contextGroupRevision", "sourceOrder"], "sourceOrder": ["contextGroupId", "contextGroupRevision", "contextHash"] },
      "additionalProperties": false
    },
    "questionAlias": { "type": "object", "properties": { "legacyNamespace": { "$ref": "common.schema.json#/$defs/identifier" }, "legacyId": { "$ref": "common.schema.json#/$defs/identifier" }, "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "decision": { "enum": ["verified", "ambiguous", "unresolved"] }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["legacyNamespace", "legacyId", "questionKey", "decision", "evidenceIds"], "additionalProperties": false },
    "contextAsset": { "type": "object", "properties": { "resource": { "$ref": "common.schema.json#/$defs/resourceRef" }, "hash": { "$ref": "common.schema.json#/$defs/hash" }, "answerLeakReviewId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["resource", "hash", "answerLeakReviewId"], "additionalProperties": false },
    "contextMember": { "type": "object", "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "revision": { "type": "integer", "minimum": 1 }, "sourceOrder": { "type": "integer", "minimum": 1 } }, "required": ["questionKey", "revision", "sourceOrder"], "additionalProperties": false },
    "contextGroup": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "text": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "assets": { "type": "array", "items": { "$ref": "#/$defs/contextAsset" } }, "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contextMember" } }, "contiguous": { "const": true }, "preserveSourceOrder": { "const": true }, "sourceHashes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/hash" }, "uniqueItems": true }, "reviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["id", "revision", "contentHash", "text", "assets", "members", "contiguous", "preserveSourceOrder", "sourceHashes", "reviewIds"], "additionalProperties": false },
    "questionDifficulty": {
      "type": "object",
      "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "question": { "$ref": "common.schema.json#/$defs/questionRef" }, "value": { "enum": ["easy", "medium", "hard", null] }, "basis": { "enum": ["editorial", "empirical", "unknown"] }, "rubricVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "rationale": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "reviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "sampleSize": { "type": "integer", "minimum": 1 }, "observationPeriod": { "type": "object", "properties": { "from": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "to": { "$ref": "common.schema.json#/$defs/utcTimestamp" } }, "required": ["from", "to"], "additionalProperties": false } },
      "required": ["id", "question", "value", "basis", "rubricVersion", "rationale", "evidenceIds", "reviewIds"],
      "allOf": [{ "if": { "properties": { "basis": { "const": "unknown" } }, "required": ["basis"] }, "then": { "properties": { "value": { "const": null } } } }, { "if": { "properties": { "basis": { "enum": ["editorial", "empirical"] } }, "required": ["basis"] }, "then": { "properties": { "value": { "enum": ["easy", "medium", "hard"] }, "rationale": { "minLength": 1 } } } }, { "if": { "properties": { "basis": { "const": "empirical" } }, "required": ["basis"] }, "then": { "required": ["sampleSize", "observationPeriod"] } }],
      "additionalProperties": false
    },
    "guideRef": { "type": "object", "properties": { "anchorId": { "$ref": "common.schema.json#/$defs/identifier" }, "levelId": { "$ref": "common.schema.json#/$defs/levelId" }, "guideKey": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "nodeId": { "$ref": "common.schema.json#/$defs/identifier" }, "blockIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "sourceHash": { "$ref": "common.schema.json#/$defs/hash" }, "pageIndexes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }, "quote": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "anchor": { "type": ["string", "null"] }, "precision": { "enum": ["exact", "parent", "chapter"] }, "fallbackRoute": { "type": "string", "pattern": "^/guide/[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+$" } }, "required": ["anchorId", "levelId", "guideKey", "nodeId", "blockIds", "sourceHash", "pageIndexes", "quote", "anchor", "precision", "fallbackRoute"], "additionalProperties": false },
    "guideHistory": { "type": "object", "properties": { "sourceHash": { "$ref": "common.schema.json#/$defs/hash" }, "blockIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "nodeId": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["sourceHash", "blockIds", "nodeId"], "additionalProperties": false },
    "guideAnchorRecord": { "type": "object", "properties": { "anchorId": { "$ref": "common.schema.json#/$defs/identifier" }, "current": { "$ref": "#/$defs/guideRef" }, "history": { "type": "array", "items": { "$ref": "#/$defs/guideHistory" } }, "status": { "enum": ["resolved", "needs_review", "orphaned"] }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["anchorId", "current", "history", "status", "evidenceIds"], "additionalProperties": false }
  }
}
