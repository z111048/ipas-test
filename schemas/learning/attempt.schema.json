{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/attempt.schema.json",
  "title": "Attempt and learner progress contracts",
  "$defs": {
    "promptSnapshot": { "type": "object", "properties": { "stem": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/option" } } }, "required": ["stem", "options"], "additionalProperties": false },
    "attemptAsset": { "type": "object", "properties": { "path": { "$ref": "common.schema.json#/$defs/safePath" }, "hash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["path", "hash"], "additionalProperties": false },
    "attemptItem": { "type": "object", "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "position": { "type": "integer", "minimum": 0 }, "promptSnapshot": { "$ref": "#/$defs/promptSnapshot" }, "assets": { "type": "array", "items": { "$ref": "#/$defs/attemptAsset" } }, "contextSnapshot": { "type": "string" }, "displayedOptionIds": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "uniqueItems": true }, "selectedOptionId": { "type": ["string", "null"], "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "answeredAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] } }, "required": ["questionKey", "revision", "contentHash", "position", "promptSnapshot", "assets", "displayedOptionIds", "selectedOptionId", "answeredAt"], "additionalProperties": false },
    "scoringSnapshot": { "type": "object", "properties": { "correct": { "type": "number" }, "incorrect": { "const": 0 }, "unanswered": { "const": 0 }, "passingPercent": { "type": "number", "minimum": 0, "maximum": 100 } }, "required": ["correct", "incorrect", "unanswered", "passingPercent"], "additionalProperties": false },
    "answerKey": { "type": "object", "properties": { "questionKey": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$", "maxLength": 512 }, "revision": { "type": "integer", "minimum": 1 }, "correctOptionId": { "type": "string", "pattern": "^opt-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" } }, "required": ["questionKey", "revision", "correctOptionId"], "additionalProperties": false },
    "attemptResult": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "eligibleCount": { "type": "integer", "minimum": 1 }, "correctCount": { "type": "integer", "minimum": 0 }, "invalidatedQuestionKeys": { "type": "array", "items": { "type": "string", "pattern": "^q:(?:junior|middle):[^:]+:[^:]+$" }, "uniqueItems": true }, "answerKeySnapshot": { "type": "array", "items": { "$ref": "#/$defs/answerKey" } } }, "required": ["score", "eligibleCount", "correctCount", "invalidatedQuestionKeys", "answerKeySnapshot"], "additionalProperties": false },
    "attemptSnapshot": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "attemptId": { "$ref": "common.schema.json#/$defs/identifier" }, "mode": { "enum": ["practice", "simulation"] }, "status": { "enum": ["active", "submitted", "abandoned"] }, "formId": { "$ref": "common.schema.json#/$defs/identifier" }, "releaseId": { "$ref": "common.schema.json#/$defs/identifier" }, "blueprintHash": { "$ref": "common.schema.json#/$defs/hash" }, "poolRef": { "$ref": "mock.schema.json#/$defs/poolRef" }, "poolHash": { "$ref": "common.schema.json#/$defs/hash" }, "seed": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "algorithmVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "startedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "deadlineAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] }, "submittedAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attemptItem" } }, "scoringSnapshot": { "$ref": "#/$defs/scoringSnapshot" }, "result": { "$ref": "#/$defs/attemptResult" } }, "required": ["schemaVersion", "attemptId", "mode", "status", "formId", "releaseId", "blueprintHash", "poolRef", "poolHash", "seed", "algorithmVersion", "startedAt", "deadlineAt", "submittedAt", "items", "scoringSnapshot"], "additionalProperties": false },
    "learnerProgress": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "target": { "$ref": "common.schema.json#/$defs/entityRef" }, "targetHash": { "$ref": "common.schema.json#/$defs/hash" }, "writeVersion": { "type": "integer", "minimum": 1 }, "state": { "enum": ["not_started", "in_progress", "self_reported_complete"] }, "openedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "selfReportedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "updatedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" } }, "required": ["schemaVersion", "target", "targetHash", "writeVersion", "state", "updatedAt"], "additionalProperties": false },
    "attemptStorageEnvelope": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "writeVersion": { "type": "integer", "minimum": 1 }, "snapshotHash": { "$ref": "common.schema.json#/$defs/hash" }, "snapshot": { "$ref": "#/$defs/attemptSnapshot" }, "importedFrom": { "$ref": "common.schema.json#/$defs/identifier" } }, "required": ["schemaVersion", "writeVersion", "snapshotHash", "snapshot"], "additionalProperties": false },
    "revisedResult": { "type": "object", "properties": { "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "eligibleCount": { "type": "integer", "minimum": 0 }, "correctCount": { "type": "integer", "minimum": 0 } }, "required": ["score", "eligibleCount", "correctCount"], "additionalProperties": false },
    "scoreAmendment": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "attemptId": { "$ref": "common.schema.json#/$defs/identifier" }, "originalSnapshotHash": { "$ref": "common.schema.json#/$defs/hash" }, "createdAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "reason": { "enum": ["answer_corrected", "question_disputed", "question_withdrawn"] }, "affectedQuestions": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/questionRef" } }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }, "revisedResult": { "$ref": "#/$defs/revisedResult" } }, "required": ["id", "attemptId", "originalSnapshotHash", "createdAt", "reason", "affectedQuestions", "evidenceRefs", "revisedResult"], "additionalProperties": false }
  }
}
