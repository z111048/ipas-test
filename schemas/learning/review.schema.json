{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipas.example/schemas/learning/review.schema.json",
  "title": "Evidence and review contracts",
  "$defs": {
    "evidence": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "common.schema.json#/$defs/hash" }, "kind": { "enum": ["source_quote", "guide_location", "execution", "editorial_reasoning"] }, "source": { "$ref": "common.schema.json#/$defs/sourceSnapshot" }, "guideRef": { "$ref": "identity.schema.json#/$defs/guideRef" }, "claim": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "locator": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "excerpt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "observedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "artifactRef": { "$ref": "common.schema.json#/$defs/safePath" }, "artifactHash": { "$ref": "common.schema.json#/$defs/hash" } }, "required": ["id", "revision", "contentHash", "kind", "claim"], "dependentRequired": { "artifactRef": ["artifactHash"], "artifactHash": ["artifactRef"] }, "additionalProperties": false },
    "qualification": { "type": "object", "properties": { "scope": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "grantedBy": { "$ref": "common.schema.json#/$defs/identifier" }, "grantedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" } }, "required": ["scope", "evidenceIds", "grantedBy", "grantedAt"], "additionalProperties": false },
    "reviewCheck": { "type": "object", "properties": { "code": { "$ref": "common.schema.json#/$defs/identifier" }, "verdict": { "enum": ["pass", "fail", "not_run"] }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true } }, "required": ["code", "verdict", "evidenceIds"], "additionalProperties": false },
    "review": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "subject": { "$ref": "common.schema.json#/$defs/subjectRef" }, "dependencyHashes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/hash" }, "uniqueItems": true }, "rubricVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "reviewerId": { "$ref": "common.schema.json#/$defs/identifier" }, "reviewerRole": { "$ref": "#/$defs/reviewerRole" }, "authorId": { "$ref": "common.schema.json#/$defs/identifier" }, "responsibility": { "$ref": "#/$defs/responsibility" }, "qualification": { "$ref": "#/$defs/qualification" }, "evidenceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }, "verdict": { "enum": ["approved", "changes_requested", "rejected", "incomplete"] }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewCheck" } }, "createdAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }, "supersedes": { "$ref": "common.schema.json#/$defs/identifier" }, "rationale": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "required": ["id", "subject", "dependencyHashes", "rubricVersion", "reviewerId", "reviewerRole", "authorId", "responsibility", "qualification", "evidenceRefs", "verdict", "checks", "createdAt", "rationale"], "additionalProperties": false },
    "reviewerRole": { "enum": ["human", "independent_model", "automated_check"] },
    "responsibility": { "enum": ["domain_content", "assessment_answer", "notebook_execution", "deterministic_contract"] },
    "questionMapping": { "type": "object", "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "question": { "$ref": "common.schema.json#/$defs/questionRef" }, "target": { "oneOf": [{ "type": "object", "properties": { "kind": { "const": "topic" }, "ref": { "$ref": "common.schema.json#/$defs/topicRef" } }, "required": ["kind", "ref"], "additionalProperties": false }, { "type": "object", "properties": { "kind": { "const": "guide" }, "ref": { "$ref": "identity.schema.json#/$defs/guideRef" } }, "required": ["kind", "ref"], "additionalProperties": false }] }, "relation": { "enum": ["assesses", "distractor_only", "prerequisite", "explained_by"] }, "verdict": { "enum": ["correct", "too_broad", "incorrect", "unreviewed"] }, "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "reviewIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "supersedes": { "$ref": "common.schema.json#/$defs/identifier" }, "origin": { "enum": ["legacy_import", "editorial"] } }, "required": ["id", "question", "target", "relation", "verdict", "evidenceIds", "reviewIds", "origin"], "additionalProperties": false },
    "policyRequirement": { "type": "object", "properties": { "subjectKind": { "$ref": "common.schema.json#/$defs/identifier" }, "responsibility": { "$ref": "#/$defs/responsibility" }, "allowedReviewerRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewerRole" }, "uniqueItems": true }, "qualificationScope": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "rubricVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "requiredCheckCodes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true }, "independentFromAuthor": { "type": "boolean" } }, "required": ["subjectKind", "responsibility", "allowedReviewerRoles", "qualificationScope", "rubricVersion", "requiredCheckCodes", "independentFromAuthor"], "additionalProperties": false },
    "reviewPolicy": { "type": "object", "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "type": "integer", "minimum": 1 }, "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policyRequirement" } } }, "required": ["schemaVersion", "id", "version", "requirements"], "additionalProperties": false }
  }
}
